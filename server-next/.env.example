# Server
PORT=3002
# HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Auth
JWT_SECRET=your-jwt-secret-here

# Cloudinary (dipakai untuk upload semua foto: galeri, foto anak, foto coach/staff, dll)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Rintisan Payment Gateway
# sandbox saat development, ganti ke "production" saat live
RINTISAN_ENV=sandbox
# Opsional, default otomatis mengikuti RINTISAN_ENV kalau dikosongkan:
# RINTISAN_BASE_URL=https://api.sandbox.rintisan.co.id
RINTISAN_CLIENT_ID=
RINTISAN_API_KEY=
# Token custom yang dikirim Rintisan di header x-callback-token saat callback
RINTISAN_CALLBACK_TOKEN=

# Private key KITA (buat sign request keluar ke Rintisan). Isi salah satu:
# - RINTISAN_PRIVATE_KEY: isi PEM langsung (atau base64-nya), atau
# - RINTISAN_PRIVATE_KEY_PATH: path ke file .pem (default: ./keys/rintisan_private.pem)
RINTISAN_PRIVATE_KEY_PATH=./keys/rintisan_private.pem

# Public key RINTISAN (buat verifikasi signature callback masuk). Isi salah satu:
# - RINTISAN_PUBLIC_KEY: isi PEM langsung (atau base64-nya), atau
# - RINTISAN_PUBLIC_KEY_PATH: path ke file .pem (default: ./keys/rintisan_public.pem)
RINTISAN_PUBLIC_KEY_PATH=./keys/rintisan_public.pem
