generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  head_coach
  coach
  parent
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  phone     String?
  photo     String?
  signature String?
  bio       String?
  address   String?
  status    String   @default("active")
  // Honor harian coach (rupiah). Dipakai menu Payroll untuk menghitung
  // honor = hari hadir terverifikasi x tarif, ditambah bonus/potongan manual.
  dailyRate Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students                 Student[]         @relation("ParentStudents")
  coachAttendances         Attendance[]      @relation("CoachAttendances")
  trainingSessions         TrainingSession[]
  schedules                Schedule[]
  notifications            Notification[]
  staffAttendances                 StaffAttendance[] @relation("StaffAttendanceUser")
  verifiedStaffAttendances         StaffAttendance[] @relation("StaffAttendanceVerifiedBy")
  verifiedStaffAttendanceCheckouts StaffAttendance[] @relation("StaffAttendanceCheckoutVerifiedBy")
  eventStaffAttendances            EventStaffAttendance[] @relation("EventStaffAttendanceUser")
  verifiedEventStaffAttendances    EventStaffAttendance[] @relation("EventStaffAttendanceVerifiedBy")
  verifiedEventStaffCheckouts      EventStaffAttendance[] @relation("EventStaffAttendanceCheckoutVerifiedBy")
  events                   Event[]
  passwordResets           PasswordReset[]
  ledgerEntries            LedgerEntry[]
  branches                 UserBranch[]
  cartItemsAdded           CartItem[]        @relation("CartItemAddedBy")
  paymentRemindersSent     PaymentReminder[] @relation("PaymentReminderSender")
  paymentAudits            PaymentAuditLog[] @relation("PaymentAuditActor")
  paymentProofsUploaded    Payment[]         @relation("PaymentProofUploader")
  payrolls                 CoachPayroll[]    @relation("CoachPayrollCoach")
  generatedPayrolls        CoachPayroll[]    @relation("CoachPayrollGeneratedBy")
  coachAttendanceSessions        CoachAttendanceSession[] @relation("CoachAttendanceSessionCoach")
  createdCoachAttendanceSessions CoachAttendanceSession[] @relation("CoachAttendanceSessionCreator")
  assignedAttendanceSessions     CoachAttendanceSessionCoach[]
  scheduleAssignments            ScheduleCoach[]

  @@map("users")
}

// A coach/head_coach can be assigned to multiple branches; admin is
// unrestricted regardless, parent has no branch assignment.
model UserBranch {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model Branch {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  status          String   @default("active")
  registrationFee Int      @default(750000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            UserBranch[]
  students         Student[]
  schedules        Schedule[]
  staffAttendances StaffAttendance[]
  eventStaffAttendances EventStaffAttendance[]
  fields           Field[]
  trainingSessions TrainingSession[]
  events           EventBranch[]
  branchPackages   BranchPackage[]
  ledgerEntries    LedgerEntry[]
  coachAttendanceSessions CoachAttendanceSession[]

  @@map("branches")
}

model StaffAttendance {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("StaffAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  // Sesi absensi yang menjadi dasar check-in (jam buka/tutup). Baris lama
  // (dan absensi head coach) boleh null; absensi coach baru selalu terisi.
  sessionId    String?
  session      CoachAttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  date         DateTime
  status       String    @default("hadir")
  checkInTime  DateTime?
  photo        String?
  latitude     Float?
  longitude    Float?
  locationName String?
  verifyStatus String    @default("pending")
  verifiedById String?
  verifiedBy   User?     @relation("StaffAttendanceVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  rejectReason String?

  // Check-out mirrors check-in exactly (own selfie + geolocation + its own
  // independent admin verification) — null checkOutVerifyStatus means the
  // person hasn't checked out yet today, as opposed to pending/approved/rejected.
  checkOutTime         DateTime?
  checkOutPhoto        String?
  checkOutLatitude     Float?
  checkOutLongitude    Float?
  checkOutLocationName String?
  checkOutVerifyStatus String?
  checkOutVerifiedById String?
  checkOutVerifiedBy   User?     @relation("StaffAttendanceCheckoutVerifiedBy", fields: [checkOutVerifiedById], references: [id])
  checkOutVerifiedAt   DateTime?
  checkOutRejectReason String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Satu baris per sesi absensi. `sessionId` null dipakai baris lama dan
  // absensi head coach (mode bebas); Postgres menganggap NULL unik sehingga
  // banyak baris legacy tetap aman. Index tanggal dipakai rekap & payroll.
  @@unique([userId, sessionId])
  @@index([date])
  @@map("staff_attendances")
}

// Jadwal absensi coach per sesi. Dibuat otomatis dari sesi latihan / event
// (dengan jam default) dan bisa diatur admin/head coach: jam buka-tutup absen
// masuk dan batas absen pulang. Dampak event/tournament ke payroll ditentukan
// manual lewat bonus/deduction di menu Payroll.
model CoachAttendanceSession {
  id                String   @id @default(cuid())
  type              String   // training | event | tournament
  title             String
  date              DateTime // awal hari (zona waktu server = WIB)
  branchId          String?
  branch            Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // null = semua coach di cabang; terisi = hanya coach tersebut.
  coachId           String?
  coach             User?    @relation("CoachAttendanceSessionCoach", fields: [coachId], references: [id], onDelete: SetNull)
  trainingSessionId String?  @unique
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  // Jadwal latihan (Schedule) yang menjadi sumber sesi ini: jam & coach bertugas mengikuti jadwal.
  scheduleId        String?  @unique
  schedule          Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  // true = jam diatur manual dan tidak ditimpa saat jadwal/event berubah.
  windowManual      Boolean  @default(false)
  eventId           String?
  event             Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Format "HH:mm" (WIB). Absen pulang tidak punya jam buka, hanya batas akhir.
  checkInOpen   String @default("00:00")
  checkInClose  String @default("23:59")
  checkOutClose String @default("23:59")

  status        String  @default("active") // active | cancelled
  note          String?
  createdById   String?
  createdBy     User?   @relation("CoachAttendanceSessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendances StaffAttendance[]

  // Coach yang ditugaskan (banyak). Kosong = semua coach di cabang (perilaku
  // lama); `coachId` di atas tetap dipakai sesi latihan (satu coach).
  assignedCoaches CoachAttendanceSessionCoach[]

  @@index([date, branchId])
  @@index([eventId])
  @@map("coach_attendance_sessions")
}

model CoachAttendanceSessionCoach {
  id        String                 @id @default(cuid())
  sessionId String
  session   CoachAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime               @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("coach_attendance_session_coaches")
}

model EventStaffAttendance {
  id           String  @id @default(cuid())
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User    @relation("EventStaffAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch? @relation(fields: [branchId], references: [id])
  date         DateTime
  status       String  @default("hadir")
  checkInTime  DateTime?
  photo        String?
  latitude     Float?
  longitude    Float?
  locationName String?
  verifyStatus String  @default("pending")
  verifiedById String?
  verifiedBy   User?   @relation("EventStaffAttendanceVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  rejectReason String?

  checkOutTime         DateTime?
  checkOutPhoto        String?
  checkOutLatitude     Float?
  checkOutLongitude    Float?
  checkOutLocationName String?
  checkOutVerifyStatus String?
  checkOutVerifiedById String?
  checkOutVerifiedBy   User?     @relation("EventStaffAttendanceCheckoutVerifiedBy", fields: [checkOutVerifiedById], references: [id])
  checkOutVerifiedAt   DateTime?
  checkOutRejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@map("event_staff_attendances")
}

model Field {
  id        String   @id @default(cuid())
  name      String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  trainingSessions TrainingSession[]

  @@map("fields")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Student {
  id                             String    @id @default(cuid())
  userId                         String
  user                           User      @relation("ParentStudents", fields: [userId], references: [id])
  studentId                      String    @unique
  fullName                       String
  dateOfBirth                    DateTime
  position                       String
  ageGroup                       String
  photo                          String?
  parentName                     String
  parentPhone                    String
  parentEmail                    String?
  address                        String
  packageId                      String?
  package                        Package?  @relation(fields: [packageId], references: [id])
  packageStartDate               DateTime?
  packageEndDate                 DateTime?
  totalSessions                  Int?
  sessionsUsed                   Int       @default(0)
  sessionMonth                   Int?
  sessionYear                    Int?
  status                         String    @default("active")
  // true = dikecualikan dari tagihan BPJS otomatis / "Tagih Sekarang".
  bpjsExempt                     Boolean   @default(false)
  branchId                       String?
  branch                         Branch?   @relation(fields: [branchId], references: [id])
  // Beasiswa (scholarship) — admin-only, set from Data Anak. 0 = none.
  // registrationScholarshipPercent only ever matters at initial registration;
  // sppScholarshipPercent is re-applied automatically on every renewal.
  registrationScholarshipPercent Float     @default(0)
  sppScholarshipPercent          Float     @default(0)
  // "Anak Lama" — a legacy member kept on a hidden custom-priced package
  // (see Package.isCustom) instead of the standard Pengaturan catalog.
  isOldMember                    Boolean   @default(false)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  payments          Payment[]
  attendances       Attendance[]
  assessments       Assessment[]
  reports           Report[]
  studentCard       StudentCard?
  eventParticipants EventParticipant[]
  cartItems         CartItem[]
  paymentReminders  PaymentReminder[]

  @@map("students")
}

model Package {
  id              String   @id @default(cuid())
  name            String
  durationMonths  Int
  sessionsPerWeek Int
  price           Int
  status          String   @default("active")
  // A hidden, student-specific legacy price ("anak lama") — excluded from
  // the public/branch catalog and Pengaturan's package list, but assignable
  // via Student.packageId like any other package so every existing
  // session/quota computation (which always keys off student.package)
  // works unchanged.
  isCustom        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  students       Student[]
  payments       Payment[]
  branchPackages BranchPackage[]

  @@map("packages")
}

model BranchPackage {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  price     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, packageId])
  @@map("branch_packages")
}

model Payment {
  id                 String            @id @default(cuid())
  studentId          String
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  packageId          String?
  package            Package?          @relation(fields: [packageId], references: [id])
  eventParticipantId String?           @unique
  eventParticipant   EventParticipant? @relation(fields: [eventParticipantId], references: [id])
  amount             Int
  registrationFee    Int               @default(0)
  totalAmount        Int
  paymentType        String
  status             String            @default("pending")
  paymentMethod      String?
  // Keterangan pembayaran yang diisi admin/head_coach: "Cash", "Transfer
  // Manual", "Anak Berprestasi", dsb. Ikut tampil di Keuangan > Pemasukan.
  note               String?
  transactionId      String?
  paymentLink        String?
  qrString           String?
  failReason         String?
  callbackPayload    Json?
  paidAt             DateTime?
  effectsAppliedAt   DateTime?
  // Bukti pembayaran (foto/screenshot transfer, QRIS, dsb.) yang diunggah
  // parent/admin. WAJIB ada supaya pembayaran ikut dihitung sebagai pemasukan
  // di laporan keuangan (lihat lib/paymentProof.js).
  proofUrl           String?
  proofNote          String?
  proofUploadedAt    DateTime?
  proofUploadedById  String?
  proofUploadedBy    User?             @relation("PaymentProofUploader", fields: [proofUploadedById], references: [id], onDelete: SetNull)
  // Data lama (sebelum fitur bukti) ditandai true agar tetap dihitung apa
  // adanya. Pembayaran baru default false -> wajib punya bukti.
  proofExempt        Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  cartItems          CartItem[]

  @@index([proofUploadedById])
  @@map("payments")
}

// Holds registration-wizard data for a new student BEFORE the first payment
// succeeds. No User/Student/Payment row is created until the Rintisan webhook
// confirms success — this table is where the checkout billing is attached
// instead (id is used as the Rintisan partner_trx_id).
model PendingRegistration {
  id              String   @id @default(cuid())
  fullName        String
  dateOfBirth     DateTime
  position        String
  photo           String?
  branchId        String?
  parentName      String
  parentPhone     String
  address         String
  email           String
  passwordHash    String
  packageId       String
  amount          Int
  registrationFee Int
  totalAmount     Int
  paymentMethod   String?
  status          String   @default("pending") // pending | success | failed
  transactionId   String?
  paymentLink     String?
  qrString        String?
  failReason      String?
  callbackPayload Json?
  studentId       String? // set once conversion succeeds, for traceability
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pending_registrations")
}

model Attendance {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coachId     String?
  coach       User?     @relation("CoachAttendances", fields: [coachId], references: [id])
  date        DateTime
  status      String
  checkInTime DateTime?
  method      String    @default("manual")
  notes       String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([studentId, date])
  @@map("attendances")
}

model TrainingSession {
  id               String   @id @default(cuid())
  coachId          String
  coach            User     @relation(fields: [coachId], references: [id])
  ageGroup         String
  date             DateTime
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id])
  fieldId          String?
  field            Field?   @relation(fields: [fieldId], references: [id])
  // Nama lapangan yang diketik manual (bila bukan dari daftar Field).
  fieldName        String?
  topicTitle       String
  topicDescription String?
  objective        String?
  duration         String?
  equipment        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attendanceSession CoachAttendanceSession?

  @@map("training_sessions")
}

model Event {
  id                   String    @id @default(cuid())
  title                String
  description          String?
  type                 String
  ageGroup             String?
  date                 DateTime
  registrationDeadline DateTime?
  // Jam mulai/selesai event "HH:mm" (WIB); dipakai menghitung jendela absen coach.
  startTime            String?
  endTime              String?
  location             String?
  fee                  Int       @default(0)
  status               String    @default("open")
  createdById          String
  createdBy            User      @relation(fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  participants EventParticipant[]
  branches     EventBranch[]
  staffAttendances EventStaffAttendance[]
  attendanceSessions CoachAttendanceSession[]

  @@map("events")
}

// No rows here for an event means "all branches" — same semantic the old
// single nullable Event.branchId used, just expressed as an empty relation
// instead of null, so callers don't need a separate all-branches special case.
model EventBranch {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([eventId, branchId])
  @@map("event_branches")
}

model EventParticipant {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        String   @default("recommended")
  paymentStatus String   @default("unpaid")
  notes         String?
  addedAt       DateTime @default(now())

  payment Payment?

  @@unique([eventId, studentId])
  @@map("event_participants")
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  token     String   @unique
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("password_resets")
}

model Assessment {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coachId        String
  assessmentDate DateTime
  // Period is a range [month/year, endMonth/endYear] inclusive; a
  // single-month rapor just has endMonth/endYear equal to month/year.
  month          Int
  year           Int
  endMonth       Int
  endYear        Int
  // Category keys (from FIELD_PLAYER_CATEGORIES/GK_CATEGORIES) the coach
  // chose to actually grade this period — categories left unchecked are
  // hidden from the parent view and the PDF, and excluded from overallAvg.
  activeCategories String[] @default([])

  // TEKNIK (field player)
  passing           Int?
  control           Int?
  runningWithBall   Int?
  dribbling         Int?
  shooting          Int?
  longPassing       Int?
  oneVsOneAttacking Int?
  oneVsOneDefending Int?
  teknikAvg         Float?

  // TEKNIK (goalkeeper) — separate columns since GK technical skills are
  // entirely different criteria (catching, kicking, throwing, etc.), not a
  // subset of the field-player list above. Shares teknikAvg above.
  gkCatching       Int?
  gkKicking        Int?
  gkThrowing       Int?
  gkVolleying      Int?
  gkDropKick       Int?
  gkGoalKick       Int?
  gkFootwork       Int?
  gkOneVsOneTeknik Int?

  // TAKTIK - ATTACKING (field player fields also reused by GK, which adds
  // gkPositionAttacking on top and drops a few — see GK_CATEGORIES)
  attackingPrinciples Int?
  possession          Int?
  transitionAttacking Int?
  combinationPlay     Int?
  switchingPlay       Int?
  playingOutFromBack  Int?
  finishingFinalThird Int?
  gkPositionAttacking Int?
  attackingAvg        Float?

  // TAKTIK - DEFENDING (field player)
  defendingPrinciples Int?
  zonalDefending      Int?
  retreatRecovery     Int?
  compactness         Int?
  transitionDefending Int?
  defendingAvg        Float?
  taktikAvg           Float?

  // TAKTIK - DEFENDING (goalkeeper) — entirely GK-specific scenarios
  gkPositionDefending Int?
  gkDealCrossing      Int?
  gkDealCornerKick    Int?
  gkDealFreeKick      Int?
  gkDealLongPass      Int?
  gkOneVsOneTaktik    Int?

  // FISIK
  maximalStrength Int?
  aerobicCapacity Int?
  reaction        Int?
  acceleration    Int?
  maximalSpeed    Int?
  speedEndurance  Int?
  awareness       Int?
  power           Int?
  fisikAvg        Float?

  // MENTAL
  selfConfidence Int?
  decision       Int?
  leadership     Int?
  enthusiasm     Int?
  communication  Int?
  discipline     Int?
  mentalAvg      Float?

  // LITTLE MAVERICK (U-8 and under, non-GK) — a simpler 4-category form with
  // no Attacking/Defending split; "Taktik & Pemahaman" below maps onto
  // attackingAvg so taktikAvg still derives correctly with no new avg column.
  lmAgility       Int? // Gerak Motorik & Fisik -> fisikAvg
  lmSpeed         Int?
  lmStrength      Int?
  lmCoordination  Int?
  lmDribbling     Int? // Teknik Dasar Sepakbola -> teknikAvg
  lmPassing       Int?
  lmShooting      Int?
  lmBallControl   Int?
  lmThrowIn       Int?
  lmPositioning   Int? // Taktik & Pemahaman -> attackingAvg
  lmDecisionMaking Int?
  lmDiscipline    Int? // Mental & Sikap Latihan -> mentalAvg
  lmMotivation    Int?
  lmTeamwork      Int?
  lmResponsiveness Int?

  // OVERALL
  overallAvg   Float?
  coachComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@unique([studentId, month, year, endMonth, endYear])
  @@map("assessments")
}

model Report {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  endMonth     Int
  endYear      Int
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  pdfUrl       String?
  generatedAt  DateTime?
  sentToParent Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@map("reports")
}

model Schedule {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  location  String
  // Catatan head coach untuk coach yang bertugas (hanya terlihat staf & coach bertugas).
  coachNote String?
  coachId   String?
  coach     User?    @relation(fields: [coachId], references: [id])
  status    String   @default("active")
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Coach yang bertugas (banyak); kosong = semua coach cabang. Sesi absensi
  // coach dibuat otomatis dari jadwal ini.
  coaches           ScheduleCoach[]
  attendanceSession CoachAttendanceSession?

  // One branch can't have two jadwal on the same date — prevents double-
  // booking; a different branch on the same date is unaffected.
  @@unique([branchId, date])
  @@map("schedules")
}

model ScheduleCoach {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([scheduleId, userId])
  @@index([userId])
  @@map("schedule_coaches")
}

model CmsContent {
  id        String   @id @default(cuid())
  section   String
  title     String?
  content   Json?
  image     String?
  order     Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_contents")
}

// Manual bookkeeping entries logged by admin/head_coach (e.g. ad-hoc training
// expenses, cash income not tied to a Payment). "Pemasukan" views union
// LedgerEntry(type=income) with successful Payment rows; "Pengeluaran" is
// LedgerEntry(type=expense) only, since expenses have no Payment counterpart.
model LedgerEntry {
  id          String   @id @default(cuid())
  type        String // income | expense
  category    String?
  description String
  amount      Int
  date        DateTime @default(now())
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ledger_entries")
}

model StudentCard {
  id         String   @id @default(cuid())
  studentId  String   @unique
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  qrCode     String   @unique
  cardNumber String   @unique
  issuedAt   DateTime @default(now())
  status     String   @default("active")
  createdAt  DateTime @default(now())

  @@map("student_cards")
}

// Keranjang belanja per anak ("Keranjang & Pembayaran Gabungan").
// Sebelum checkout: status "open" + paymentId NULL — daftar item yang menunggu
// dibayar. Setelah checkout dibuat, semua item anak itu dikaitkan ke satu
// Payment (paymentId terisi, status "checked_out"), sehingga satu transaksi
// bisa memuat beberapa item (perpanjangan paket, BPJS, merchandise) sekaligus
// sementara pemasukan tetap dipecah per `category` di laporan keuangan.
model CartItem {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  // Item yang diambil dari katalog merchandise (Katalog Merchandise). NULL untuk
  // item yang diketik manual (perpanjangan paket, BPJS, merchandise custom).
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  type      String // 'package' | 'bpjs' | 'merchandise'
  label     String // teks yang tampil di keranjang & rincian pembayaran
  category  String // kategori pemasukan di laporan keuangan, mis. "Perpanjangan Paket"
  amount    Int
  metadata  Json?  // payload per tipe: { packageId } | { periodMonth, periodYear } | { productId, size, qty, jerseyNumber }

  // Khusus item BPJS: periode tagihan (bulan/tahun). Dipakai agar penagihan
  // otomatis bulanan idempoten (satu item per anak per periode) tanpa perlu
  // memfilter JSON.
  periodMonth Int?
  periodYear  Int?

  addedById String?
  addedBy   User?   @relation("CartItemAddedBy", fields: [addedById], references: [id])

  status    String   @default("open") // 'open' | 'checked_out' | 'canceled'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([paymentId])
  @@index([productId])
  @@index([type, periodMonth, periodYear])
  @@map("cart_items")
}

// Katalog merchandise (jersey, aksesori, dll) yang dikelola admin & head coach dan bisa
// dibeli parent lewat keranjang. `stock` NULL berarti stok tak terbatas; saat
// pembayaran keranjang lunas, stok item yang berasal dari katalog dikurangi.
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("Lainnya") // Jersey | Aksesori | Lainnya
  price       Int
  imageUrl    String?
  stock       Int? // NULL = tak terbatas
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems CartItem[]

  @@index([isActive])
  @@map("products")
}

// Jejak audit pembayaran ("Audit Pembayaran"). Mencatat aksi manual yang
// mengubah/menghapus pembayaran (admin & parent) serta konfirmasi otomatis dari
// gateway/rekonsiliasi, sehingga tiap perubahan uang bisa ditelusuri siapa &
// kapan. `paymentId` sengaja tanpa relasi FK (onDelete SetNull) supaya riwayat
// tetap ada walau pembayarannya sudah dihapus.
model PaymentAuditLog {
  id        String   @id @default(cuid())
  paymentId String?
  action    String // 'edit' | 'delete' | 'cancel' | 'callback_paid' | 'callback_failed' | 'reconcile_paid' | 'sync_paid' | 'invoice_created' | 'invoice_edit' | 'invoice_delete' | 'mark_paid_manual'
  actorId   String?
  actor     User?    @relation("PaymentAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole String?
  studentId String?
  amount    Int?
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_audit_logs")
}

// Slip honor bulanan seorang coach. `dailyRate` disalin saat generated supaya
// slip lama tidak berubah kalau tarif harian diubah di kemudian hari.
// `daysPresent` = jumlah hari hadir yang sudah diverifikasi admin pada periode
// tersebut; total = dailyRate * daysPresent + bonus - deduction.
model CoachPayroll {
  id            String    @id @default(cuid())
  coachId       String
  coach         User      @relation("CoachPayrollCoach", fields: [coachId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  dailyRate     Int       @default(0)
  daysPresent   Int       @default(0)
  bonus         Int       @default(0)
  deduction     Int       @default(0)
  total         Int       @default(0)
  note          String?
  status        String    @default("draft") // draft | paid
  paidAt        DateTime?
  generatedById String?
  generatedBy   User?     @relation("CoachPayrollGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([coachId, month, year])
  @@index([month, year])
  @@map("coach_payrolls")
}

// Catatan pengingat tagihan yang dikirim admin/head coach ke parent (lewat
// WhatsApp). Hanya jejak "kapan terakhir diingatkan" supaya parent tidak
// diingatkan berulang oleh dua staf.
model PaymentReminder {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sentById  String?
  sentBy    User?    @relation("PaymentReminderSender", fields: [sentById], references: [id], onDelete: SetNull)
  channel   String   @default("whatsapp")
  amount    Int
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([sentById])
  @@map("payment_reminders")
}
