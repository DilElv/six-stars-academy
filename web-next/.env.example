# API base URL used by the browser to call the backend.
# - Local dev: leave unset — falls back to http://<hostname>:3002/api
# - Production: MUST be set to the relative path "/api" so requests go
#   through Nginx on the same HTTPS origin as the site (see the
#   `location /api/` proxy_pass block in the Nginx server config).
#   NEXT_PUBLIC_* vars are inlined at build time — set this in
#   web-next/.env.production (untracked, create manually on each deploy
#   target) BEFORE running `npm run build`, otherwise the client bundle
#   falls back to an insecure http://host:3002 URL and gets blocked as
#   mixed content on an HTTPS page.
NEXT_PUBLIC_API_URL=/api
